# ============================================================================
# KADJAI TRAVELS - TVMS SERVER CONFIGURATION
# Copy this file to .env or server/.env and provide genuine secrets
# ============================================================================

PORT=3001
NODE_ENV=development

# JSON Web Token Secret (MUST be at least 32 characters in production)
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-secure-random-32-byte-hex-secret-key-here

# Token Expiry (Hours)
TOKEN_EXPIRY_HOURS=24

# Allowed CORS Origins (Comma-separated list of trusted origins)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database URL / File Path
DATABASE_URL=file:./data/kadjai_travels.db

# Owner Initial Setup (Used during initial setup or deliberate seed)
OWNER_INITIAL_PASSWORD=ChangeMeOnFirstLogin@2026
